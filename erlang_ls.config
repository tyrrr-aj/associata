## Erlang LS configuration (YAML format)
# Docs: https://erlang-ls.github.io/configuration/
# This YAML replaces the earlier Erlang-term version that failed YAML auto-detection.

apps_dirs:
  - aas-engine/apps
deps_dirs:
  - aas-engine/_build/default/lib
include_dirs:
  - aas-engine/include
  - aas-engine/apps/*/include
code_path:
  - aas-engine/_build/default/lib/*/ebin
  - aas-engine/apps/*/ebin

diagnostics:
  xref:
    enabled: true
  dialyzer:
    enabled: true
    plt_location: _build/erlang_ls_plt

dialyzer:
  - no_return
  - unmatched_returns
  - error_handling
  - race_conditions

code_lens:
  enabled: true
  test_commands:
    - rebar3 eunit
    - rebar3 ct

# Uncomment to enable upcoming formatter once stabilized
# formatter:
#   enabled: true

indexing:
  max_depth: 25

macros:
  - TEST: true

shell:
  enabled: true

experimental: []
